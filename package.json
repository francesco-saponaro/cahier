{
  "name": "cahier",
  "private": true,
  "version": "0.1.0",
  "description": "A team assistant that answers from the team's own documents with citations that open the page, and the admin console behind it: members, sharing with approval, token budgets, usage at the prices in force, audit.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter @cahier/server build",
    "build:web": "pnpm --filter @cahier/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @cahier/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
