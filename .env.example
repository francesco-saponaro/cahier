# The server (apps/server). Copy to .env; docker compose reads the same names.
DATABASE_URL=postgres://cahier:cahier@127.0.0.1:5432/cahier
PORT=3001
HOST=0.0.0.0
# Where the web app is served from in development, for CORS. Empty means same origin only.
WEB_ORIGIN=http://localhost:3000
# Sessions expire after this many hours.
SESSION_HOURS=72
# Load the demo seed into an empty database at start-up (1) or leave it empty (0).
SEED=1

# The web app (apps/web). Empty means demo mode: the same router runs in the browser on PGlite.
NEXT_PUBLIC_API_URL=http://localhost:3001
