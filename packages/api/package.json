{
  "name": "@cahier/api",
  "version": "0.1.0",
  "description": "The Cahier router: tRPC procedures over the domain's use cases, with the zod inputs the web app shares. No framework in it; Fastify serves it on the server and the browser calls it in-process for the demo.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cahier/domain": "workspace:*",
    "@trpc/server": "^11.4.3",
    "superjson": "^2.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
