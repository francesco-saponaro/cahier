{
  "name": "@cahier/web",
  "version": "0.1.0",
  "description": "The Cahier web app: Next.js (App Router, static export), Tailwind, tRPC and TanStack Query.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/demo-assets.mjs && next dev",
    "build": "node scripts/demo-assets.mjs && next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cahier/api": "workspace:*",
    "@cahier/db": "workspace:*",
    "@cahier/domain": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "11.29.7",
    "@trpc/server": "11.29.7",
    "@trpc/tanstack-react-query": "11.29.7",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
