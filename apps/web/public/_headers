# Netlify applies these to the static export. The policy is what the demo needs and nothing more:
# Next's hydration scripts are inline, PostgreSQL runs as WebAssembly, and every fetch is to this
# origin. A build that talks to a server (NEXT_PUBLIC_API_URL set) must add that origin to connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
